# Your Supabase project URL (Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key (Project Settings > API). It bypasses row level security: keep it on this server only,
# never in the app or in git.
SUPABASE_SERVICE_ROLE_KEY=
# How often to look for new submissions, in seconds.
POLL_SECONDS=30
# true: failed checks stay 'pending' for a person to review instead of being rejected automatically.
REVIEW_FAILURES=false
# Set by most container hosts. When set, GET / answers with the worker's health.
# PORT=8080
