EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional. Turns on the Google Maps / Street View pictures in the location card (see README).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Identity check (FICA) is required by default. Set to false to skip it while developing.
EXPO_PUBLIC_REQUIRE_KYC=true
